# Public runtime configuration
NEXT_PUBLIC_SITE_NAME="MyCoco"
NEXT_PUBLIC_SITE_URL="https://monprojetgarde.vercel.app"

# MyCoco production database (Neon / PostgreSQL)
# Add the private connection string in Vercel Environment Variables.
# Enable it for Production, Preview and Development.
DATABASE_URL=""

# Legacy/optional PostgreSQL variable supported by the app.
POSTGRES_URL=""

# Optional alternative Neon variable supported by the app.
NEON_DATABASE_URL=""

# Supabase - kept for compatibility with existing project configuration.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# NEVER expose service-role keys to NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=""
